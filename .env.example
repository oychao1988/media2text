# Copy to .env and fill in (never commit .env)
# DEEPGRAM_API_KEY is read when transcribe.engine=deepgram
DEEPGRAM_API_KEY=

# OPENAI_API_KEY is read when transcribe.engine=openai
OPENAI_API_KEY=

# Feishu group bot webhook (notify.feishu); never commit real URL to git
NOTIFY_FEISHU_WEBHOOK_URL=

# Feishu app credentials for image upload in rich notifications (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
