# Copy to .env and fill in (never commit .env)
# DEEPGRAM_API_KEY is read when transcribe.engine=deepgram
DEEPGRAM_API_KEY=

# OPENAI_API_KEY is read when transcribe.engine=openai
OPENAI_API_KEY=

# Feishu group bot webhook (notify.feishu); never commit real URL to git
NOTIFY_FEISHU_WEBHOOK_URL=

# Aliyun Drive (personal alipan.com) — see scripts/aliyundrive_login.py
# ALIYUN_DRIVE_LOGIN_MODE=qr|desktop|password|token|auto
# ALIYUN_DRIVE_PHONE=
# ALIYUN_DRIVE_PASSWORD=
# ALIYUN_DRIVE_REFRESH_TOKEN=
# ALIYUN_DRIVE_USE_CHROME=true   # recommended for password mode (slider captcha)
