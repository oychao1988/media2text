{
  "name": "zhuanzhu-work",
  "version": "0.1.0",
  "private": true,
  "description": "转注 Work — Electron 开发壳（OpenClaw 聊天联调）",
  "main": "main.js",
  "author": "oychao1988",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "e2e:gui": "node e2e/gui-smoke.mjs",
    "prepare-bundle": "bash ../../scripts/prepare-zhuanzhu-bundle.sh && node build/generate-icon.js",
    "verify-bundle": "bash ../../scripts/verify-zhuanzhu-bundle.sh",
    "predist": "npm run prepare-bundle",
    "package:mac": "electron-builder --mac dmg",
    "package:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run package:mac",
    "package:publish:mac": "electron-builder --mac dmg --publish always",
    "package:win": "electron-builder --win nsis",
    "package": "npm run package:mac"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.52.0"
  },
  "build": {
    "appId": "com.zhuanzhu.work",
    "productName": "转注 Work",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "!resources/**",
      "!e2e/**",
      "!**/*.md",
      "!build/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "runtime-bundle.tar.gz",
          "runtime-bundle.version",
          "bundle-manifest.json"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "转注 Work ${version}",
      "artifactName": "zhuanzhu-work-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "转注 Work-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "oychao1988",
      "repo": "media2text",
      "releaseType": "release"
    }
  }
}
